# Copy to .env and fill in what you want. Every variable is optional: with none
# set, the app runs fully offline (TF-IDF vector search + extractive answers).
# The app loads this file automatically on startup (real environment variables
# take precedence), so there's no need to export anything by hand.
# Docker: .env is deliberately NOT baked into the image; `docker compose up`
# injects it at run time (see README).

# Enables dense Gemini embeddings for vector search AND Gemini-generated answers.
GOOGLE_API_KEY=

# Optional alternatives for answer generation (also: pip install -r requirements-optional.txt).
# If several are set, precedence is Anthropic > OpenAI > Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model choices (non-secret). Change a model by editing these and restarting — no code edits.
# Embeddings: switching model/dimensionality re-embeds the corpus once (cache is keyed by both).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
# Answer generation (Flash-Lite: more free-tier throughput than Flash). "-latest" aliases
# track new releases; pin an exact ID (e.g. gemini-3.5-flash-lite) for reproducibility.
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest

# Max seconds to wait for an LLM answer before falling back to extractive (default 15).
# LLM_TIMEOUT_SECONDS=15

# Public-deployment guards (defaults shown).
RATE_LIMIT=10/minute          # per client IP, shared by /search and /compare
GLOBAL_RATE_LIMIT=300/hour    # across all clients — caps worst-case API spend
TRUSTED_PROXY_HOPS=0          # 0 locally; 2 on Render (see README)
